{
    "description": "AirLog touch display (Raspberry Pi 4, Qt 6 kiosk), Yocto 'scarthgap'",
    "expires": "2028-04-30",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.8",
                "rev": "2.8"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-raspberrypi",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-qt6": {
            "git-remote": {
                "uri": "https://code.qt.io/yocto/meta-qt6.git",
                "rev": "v6.8.9-lts"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
        {
            "name": "airlog",
            "description": "AirLog touch display image for the Raspberry Pi 4 (scarthgap)",
            "setup-dir-name": "airlog-scarthgap",
            "bb-layers": [
                "openembedded-core/meta",
                "meta-yocto/meta-poky",
                "meta-yocto/meta-yocto-bsp",
                "meta-openembedded/meta-oe",
                "meta-openembedded/meta-python",
                "meta-openembedded/meta-networking",
                "meta-raspberrypi",
                "meta-qt6"
            ],
            "bb-layers-file-relative": ["meta-airlog"],
            "notes": [
                "scarthgap has no OE configuration fragments, so conf/local.conf starts empty.",
                "Add at least these lines before running 'bitbake airlog-image':",
                "    MACHINE = \"raspberrypi4-64\"",
                "    DISTRO = \"poky\"",
                "    DISTRO_FEATURES:append = \" systemd\"",
                "    VIRTUAL-RUNTIME_init_manager = \"systemd\"",
                "    LICENSE_FLAGS_ACCEPTED += \"synaptics-killswitch\"",
                "See meta-airlog/conf/templates/airlog/local.conf.sample for the full reference configuration."
            ]
        }
        ]
    },
    "version": "1.0"
}
